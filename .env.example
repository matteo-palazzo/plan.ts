# Copia questo file in .env e completa i valori. Il file .env non va mai committato.

# --- Applicazione ---------------------------------------------------------
# Fuso orario usato per scadenze, promemoria e backup
TZ=Europe/Rome
# Porta del Raspberry su cui esporre l'app (http://<ip-raspberry>:APP_PORT)
APP_PORT=8080
# Indirizzo su cui pubblicare la porta: 0.0.0.0 = tutta la LAN, oppure l'IP LAN del Raspberry
APP_BIND=0.0.0.0
# Utente e gruppo del filesystem host proprietari di data/ e backups/ (id -u / id -g)
APP_UID=1000
APP_GID=1000
# Giorni futuri mostrati di default nella dashboard (max 31)
DASHBOARD_DAYS=7

# --- MySQL esistente ------------------------------------------------------
# Da dentro il container "localhost" è il container stesso: vedi docs/installazione.md
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=piante
DB_USER=piante
DB_PASSWORD=
# Solo se MySQL è raggiungibile tramite la sua rete Docker (vedi docs/installazione.md):
# COMPOSE_FILE=docker-compose.yml:docker-compose.mysql-network.yml
# MYSQL_DOCKER_NETWORK=nome_rete_del_container_mysql

# --- Sicurezza ------------------------------------------------------------
# Almeno 32 caratteri casuali: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Durata della sessione di login in giorni
SESSION_DAYS=30
# true solo se l'app è servita in HTTPS (es. dietro un reverse proxy con certificato)
COOKIE_SECURE=false

# --- Foto -----------------------------------------------------------------
# Dimensione massima per foto in MB (nginx accetta al massimo 160 MB per richiesta)
PHOTO_MAX_MB=15
PHOTOS_PER_ENTRY=10
# Percorso host della cartella dati (foto), montata in /data nel container
DATA_HOST_DIR=./data

# --- Telegram -------------------------------------------------------------
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Ora locale a partire dalla quale si inviano i promemoria del giorno
NOTIFY_TIME=08:00
NOTIFY_CHECK_MINUTES=10
NOTIFY_MAX_ATTEMPTS=3

# --- Backup ---------------------------------------------------------------
# Espressione cron (minuto ora giorno mese giorno_settimana): domenica alle 03:30
BACKUP_SCHEDULE=30 3 * * 0
BACKUP_RETENTION_DAYS=30
# Percorso host dei backup, montato in /backups nel container
BACKUP_HOST_DIR=./backups
